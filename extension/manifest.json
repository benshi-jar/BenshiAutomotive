{
  "manifest_version": 3,
  "name": "Walkaround: used BMW checker",
  "short_name": "Walkaround",
  "version": "0.1.0",
  "description": "See what a used BMW is due for, open recalls and a fair opening offer, right on the listing page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Walkaround",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://benshiautomotive.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.cargurus.com/*",
        "https://www.cars.com/*",
        "https://www.autotrader.com/*",
        "https://www.carmax.com/*",
        "https://www.carvana.com/*",
        "https://www.truecar.com/*",
        "https://www.facebook.com/*",
        "https://*.craigslist.org/*"
      ],
      "js": ["listing-parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
